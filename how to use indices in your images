
// Images collected from Copernicus/S2
var s2 = ee.ImageCollection('COPERNICUS/S2_HARMONIZED');

// boundaries from FAO; Use it if you are looking for analyzing municiples,cities, and coutries.
var admin2 = ee.FeatureCollection('FAO/GAUL_SIMPLIFIED_500m/2015/level2');

// Filtering the city and municiple (the corresponding boundaries in your country); 
//Centralizing the place

var Riofiltered = admin2
  .filter(ee.Filter.eq('ADM1_NAME', 'Rio De Janeiro'))
  .filter(ee.Filter.eq('ADM2_NAME','Rio De Janeiro'));
  
var geometry = Riofiltered.geometry();

// Filtering the images that I'll be taking

var imagefiltered = s2
.filter(ee.Filter.date('2019-01-01', '2020-01-01'))
.filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
.filter(ee.Filter.bounds(geometry));

// getting the median of the images that I'm wishing for

var image = imagefiltered.median();


// Calculating the basics Indices, which ones are super important for your projects

// Calculating the NDVI (Normalized Difference Vegetation Index)
//  NIR = B8; Red = B4

var ndvi = image.normalizedDifference(['B8', 'B4']).rename(['ndvi']);

// Calculating the  MNDWI (Modifiede Normalized Diffrence Water Index)
// Green = B3; SWIR1 = B11

var mndwi = image.normalizedDifference(['B3','B11']).rename(['mndwi']);

// Calculating the most boring Indice: 
// SAVI = Soil-Adjusted Vegetation Index
// 1.5*(NIR- RED)/(NIR+RED+05)

var savi = image.expression(
  '1.5 * (NIR - RED) / (NIR+RED+ 0.5)', { 
    'NIR':image.select('B8').multiply(0.0001),
    'RED': image.select('B4').multiply(0.0001)
  }).rename('savi');
  
  
// Calculating the NDBI (Normalized Difference Built-up Index)

var ndbi = image.expression(
  '(SWIR1 - NIR)/ (SWIR1+NIR)', {
    
    'SWIR1': image.select('B11').multiply(0.0001),
    'NIR': image.select('B8').multiply(0.0001),
    
  }).rename('ndbi');

// creating the visualization parameters 
  
  
var rgbVis = { min: 0, max : 3000, bands :['B4', 'B3','B2' ]};

var nvdiVis = {min: 0, max: 1, palette : ['white', 'green']};

var mnwdiVis = {min : 0, max : 0.5, palette: ['white', ' blue']};

var ndbiVis = {min: 0, max: 1, palette: ['white','red']};

// Finaly, visualizing the images with the indices

Map.addLayer(image.clip(geometry),rgbVis,'Normal' );
Map.addLayer(mndwi.clip(geometry),mnwdiVis,'Water_indice');
Map.addLayer(savi.clip(geometry),nvdiVis,'Soil-adjusted_indice');
Map.addLayer(ndvi.clip(geometry),nvdiVis,'Vegetation_indice');
Map.addLayer(ndbi.clip(geometry),ndbiVis,'Built-up_indice');



